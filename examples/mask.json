{
  "rules": [
    {
      "name": "AWS Access Key",
      "type": "regex",
      "pattern": "AKIA[0-9A-Z]{16}",
      "replacement": "__MASKED_AWS_ACCESS_KEY__"
    },
    {
      "name": "Internal Domain",
      "type": "plain",
      "pattern": "internal.company.local",
      "replacement": "__MASKED_INTERNAL_DOMAIN__"
    }
  ]
}
